@baseUrl = http://localhost:8080
@adminAuth = Basic YWRtaW46YWRtaW4xMjM=

### Non-streaming chat through local gateway - DeepSeek
POST {{baseUrl}}/v1/chat/completions
Content-Type: application/json
X-User-Id: demo
X-Trace-Id: trace-demo-001
X-Agent-Id: rag-agent-service
X-Agent-Version: 1.0.0
X-Session-Id: session-demo-001
X-Run-Id: run-demo-001
X-Purpose: enterprise-document-analysis
X-Cost-Budget: 1.00

{
  "model": "deepseek-v4-flash",
  "messages": [
    {"role": "system", "content": "You are a concise AI engineering assistant."},
    {"role": "user", "content": "解释一下 LLM Gateway 的价值。"}
  ],
  "temperature": 0.2
}

### Streaming chat through local gateway - DeepSeek
POST {{baseUrl}}/v1/chat/completions
Content-Type: application/json
Accept: text/event-stream
X-User-Id: demo
X-Trace-Id: trace-demo-stream-001
X-Agent-Id: rag-agent-service
X-Agent-Version: 1.0.0
X-Session-Id: session-demo-001
X-Run-Id: run-demo-stream-001
X-Purpose: enterprise-document-analysis
X-Cost-Budget: 1.00

{
  "model": "deepseek-v4-flash",
  "messages": [
    {"role": "user", "content": "用要点输出 WebFlux SSE 的实现注意事项。"}
  ],
  "stream": true
}

