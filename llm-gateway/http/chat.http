  "model": "deepseek-v4-flash",
  "messages": [
    {"role": "user", "content": "说明多租户 API Key 管理在 LLM Gateway 里的作用。"}
  ],
  "temperature": 0.2
}

### Chat with prompt template
POST {{baseUrl}}/v1/chat/completions
Content-Type: application/json
X-Api-Key: dev-demo-key

{
  "model": "deepseek-v4-flash",
  "prompt_template": "interview-answer",
  "variables": {
    "topic": "LLM Gateway 的请求缓存、灰度路由和熔断限流",
    "project": "Java Spring Boot WebFlux 自研大模型网关"
  },
  "temperature": 0.2
}

