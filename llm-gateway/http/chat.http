### Create bad case
POST {{baseUrl}}/admin/engineering/bad-cases
Authorization: {{adminAuth}}
Content-Type: application/json

{
  "title": "模型没有按 JSON 输出",
  "model": "deepseek-v4-flash",
  "prompt": "请输出风险等级和 CAPA 建议，必须是 JSON。",
  "modelParameters": {
    "temperature": 0.7
  },
  "modelOutput": "这个问题风险比较高，建议人工复核。",
  "expectedOutput": "{\"riskLevel\":\"HIGH\",\"capa\":{\"correctiveAction\":\"...\"}}",
  "locationMethod": "对比 JSON Schema 校验失败日志和模型原始输出定位",
  "rootCause": "Prompt 约束不够明确，且没有启用 response_format/json_object",
  "fixStrategy": "降低 temperature，补充 required JSON schema，增加后处理校验",
  "evaluationEvidence": "Golden Dataset 20 条用例中 JSON 合法率从 65% 提升到 95%",
  "owner": "demo",
  "tags": ["prompt", "json-schema", "bad-case"]
}

### Upsert output contract
PUT {{baseUrl}}/admin/engineering/output-contracts
Authorization: {{adminAuth}}
Content-Type: application/json

{
  "id": "compliance-risk-json",
  "name": "合规风险 JSON 输出契约",
  "description": "约束模型必须输出风险等级、摘要、缺陷列表和 CAPA 建议。",
  "requiredFields": ["riskLevel", "summary", "defects", "capa"],
  "schemaExample": {
    "riskLevel": "HIGH",
    "summary": "发现放行前未关闭偏差。",
    "defects": [],
    "capa": {}
  }
}

### Validate output by contract
POST {{baseUrl}}/admin/engineering/output-contracts/compliance-risk-json/validate
Authorization: {{adminAuth}}
Content-Type: application/json

{
  "riskLevel": "HIGH",
  "summary": "发现放行前未关闭偏差。",
  "defects": [],
  "capa": {
    "correctiveAction": "补开偏差并完成影响评估"
  }
}

### Upsert post-process chain
PUT {{baseUrl}}/admin/engineering/post-process-chains
Authorization: {{adminAuth}}
Content-Type: application/json

{
  "id": "compliance-json-guard",
  "name": "合规审查后处理链",
  "steps": [
    "strip-markdown-code-fence",
    "parse-json",
    "validate-required-fields",
    "normalize-risk-level",
    "high-risk-force-human-review"
  ]
}

### Record prompt experiment
POST {{baseUrl}}/admin/engineering/prompt-experiments
Authorization: {{adminAuth}}
Content-Type: application/json

{
  "promptVersionId": "compliance-risk-v2",
  "model": "deepseek-v4-flash",
  "parameters": {
    "temperature": 0.0,
    "response_format": "json_object"
  },
  "badCaseId": "manual-demo",
  "beforeOutput": "风险较高，建议人工复核。",
  "afterOutput": "{\"riskLevel\":\"HIGH\",\"summary\":\"...\",\"defects\":[],\"capa\":{}}",
  "metricSummary": {
    "jsonValidRate": 0.95,
    "schemaPassRate": 0.9
  },
  "conclusion": "Prompt 版本 v2 加入 JSON Schema 和 few-shot 后，结构化稳定性明显提升。"
}

