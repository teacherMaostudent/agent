# Resolve secrets from a secret manager; never commit real values.
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
KAFKA_IMAGE=apache/kafka:4.1.1
DEBEZIUM_CONNECT_IMAGE=quay.io/debezium/connect:3.3
# Set to 3 with an external three-broker Kafka cluster.  The reference Compose
# topology has one broker and therefore deliberately defaults to one.
KAFKA_CONNECT_INTERNAL_TOPIC_REPLICATION_FACTOR=1
DEBEZIUM_REGISTER_TIMEOUT_SECONDS=120
TEMPORAL_IMAGE=temporalio/auto-setup:1.28.1
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.3.2
OPA_IMAGE=openpolicyagent/opa:1.9.0
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.135.0

POSTGRES_USER=platform
POSTGRES_PASSWORD=secret-manager-reference
REDIS_PASSWORD=secret-manager-reference
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=secret-manager-reference

OIDC_ISSUER=https://identity.example.com/realms/agent-platform
OIDC_AUDIENCE=agent-platform
OIDC_JWKS_URL=https://identity.example.com/realms/agent-platform/protocol/openid-connect/certs
OIDC_TOKEN_URL=https://identity.example.com/realms/agent-platform/protocol/openid-connect/token
OIDC_AUTHORIZATION_URL=https://identity.example.com/realms/agent-platform/protocol/openid-connect/auth
WEB_BFF_OIDC_END_SESSION_URL=https://identity.example.com/realms/agent-platform/protocol/openid-connect/logout
WEB_BFF_OIDC_CLIENT_ID=agent-web
WEB_BFF_OIDC_CLIENT_SECRET=secret-manager-reference
WEB_BFF_PUBLIC_ORIGIN=https://agent.example.com
WEB_BFF_OIDC_REDIRECT_URI=https://agent.example.com/auth/callback
CONTROL_PLANE_WORKLOAD_CLIENT_SECRET=secret-manager-reference
GOVERNANCE_WORKLOAD_CLIENT_SECRET=secret-manager-reference
GOVERNANCE_WORM_WORKER_WORKLOAD_CLIENT_SECRET=secret-manager-reference
RAG_WORKLOAD_CLIENT_SECRET=secret-manager-reference
# These credentials are intentionally distinct.  A stolen ingestion token
# must not be accepted as a Runtime, Context or query-service identity.
RUNTIME_WORKLOAD_CLIENT_SECRET=secret-manager-reference
RUNTIME_CONNECTOR_RELAY_WORKLOAD_CLIENT_SECRET=secret-manager-reference
RUNTIME_ARTIFACT_INGESTION_RELAY_WORKLOAD_CLIENT_SECRET=secret-manager-reference
RUNTIME_SECONDARY_WORKER_WORKLOAD_CLIENT_SECRET=secret-manager-reference
CONTEXT_SERVICE_WORKLOAD_CLIENT_SECRET=secret-manager-reference
RAG_QUERY_WORKLOAD_CLIENT_SECRET=secret-manager-reference
INGESTION_API_WORKLOAD_CLIENT_SECRET=secret-manager-reference
INGESTION_WORKER_WORKLOAD_CLIENT_SECRET=secret-manager-reference
AGENT_LAB_WORKLOAD_CLIENT_SECRET=secret-manager-reference
KNOWLEDGE_WIKI_RELAY_WORKLOAD_CLIENT_SECRET=secret-manager-reference
# One leaf certificate and key per workload.  Each certificate must include
# the Compose DNS name as a SAN and be issued by AGENT_MTLS_CA_FILE.
AGENT_MTLS_CA_FILE=/secure/agent-ca.pem
RUNTIME_MTLS_CERT_FILE=/secure/agent-runtime.crt
RUNTIME_MTLS_KEY_FILE=/secure/agent-runtime.key
RUNTIME_CONNECTOR_RELAY_MTLS_CERT_FILE=/secure/runtime-connector-relay.crt
RUNTIME_ARTIFACT_INGESTION_RELAY_MTLS_CERT_FILE=/secure/runtime-artifact-ingestion-relay.crt
RUNTIME_ARTIFACT_INGESTION_RELAY_MTLS_KEY_FILE=/secure/runtime-artifact-ingestion-relay.key
RUNTIME_CONNECTOR_RELAY_MTLS_KEY_FILE=/secure/runtime-connector-relay.key
RUNTIME_SECONDARY_WORKER_MTLS_CERT_FILE=/secure/runtime-secondary-worker.crt
RUNTIME_SECONDARY_WORKER_MTLS_KEY_FILE=/secure/runtime-secondary-worker.key
GOVERNANCE_WORM_WORKER_MTLS_CERT_FILE=/secure/governance-worm-worker.crt
GOVERNANCE_WORM_WORKER_MTLS_KEY_FILE=/secure/governance-worm-worker.key
CONTROL_PLANE_MTLS_CERT_FILE=/secure/control-plane.crt
CONTROL_PLANE_MTLS_KEY_FILE=/secure/control-plane.key
GOVERNANCE_MTLS_CERT_FILE=/secure/agent-governance.crt
GOVERNANCE_MTLS_KEY_FILE=/secure/agent-governance.key
WEB_BFF_MTLS_CERT_FILE=/secure/agent-web-bff.crt
WEB_BFF_MTLS_KEY_FILE=/secure/agent-web-bff.key
CONTEXT_SERVICE_MTLS_CERT_FILE=/secure/agent-context-service.crt
CONTEXT_SERVICE_MTLS_KEY_FILE=/secure/agent-context-service.key
RAG_QUERY_MTLS_CERT_FILE=/secure/rag-query-api.crt
RAG_QUERY_MTLS_KEY_FILE=/secure/rag-query-api.key
INGESTION_API_MTLS_CERT_FILE=/secure/ingestion-api.crt
INGESTION_API_MTLS_KEY_FILE=/secure/ingestion-api.key
INGESTION_WORKER_MTLS_CERT_FILE=/secure/ingestion-worker.crt
INGESTION_WORKER_MTLS_KEY_FILE=/secure/ingestion-worker.key
TOOL_GATEWAY_MTLS_CERT_FILE=/secure/tool-gateway.crt
TOOL_GATEWAY_MTLS_KEY_FILE=/secure/tool-gateway.key
AGENT_LAB_MTLS_CERT_FILE=/secure/agent-lab.crt
AGENT_LAB_MTLS_KEY_FILE=/secure/agent-lab.key
LLM_GATEWAY_MTLS_CERT_FILE=/secure/llm-gateway.crt
LLM_GATEWAY_MTLS_KEY_FILE=/secure/llm-gateway.key
MODEL_LAB_MTLS_CERT_FILE=/secure/model-lab.crt
MODEL_LAB_MTLS_KEY_FILE=/secure/model-lab.key
PROMETHEUS_MTLS_CERT_FILE=/secure/prometheus.crt
PROMETHEUS_MTLS_KEY_FILE=/secure/prometheus.key
BLACKBOX_EXPORTER_MTLS_CERT_FILE=/secure/blackbox-exporter.crt
BLACKBOX_EXPORTER_MTLS_KEY_FILE=/secure/blackbox-exporter.key
TOOL_GATEWAY_WORKLOAD_CLIENT_SECRET=secret-manager-reference
LLM_GATEWAY_WORKLOAD_CLIENT_SECRET=secret-manager-reference

DOCUMENT_BUCKET=agent-documents-production
SESSION_ARCHIVE_BUCKET=agent-runtime-ledger-production
MODEL_ARTIFACT_BUCKET=agent-model-artifacts-production
AUDIT_BUCKET=agent-audit-production
S3_REGION=cn-hangzhou
S3_ENDPOINT_URL=
S3_KMS_KEY_ID=key-reference
WORM_KMS_KEY_ID=asymmetric-signing-key-reference

RAG_SERVICE_API_KEY=compatibility-secret-during-oidc-migration
RAG_INTERNAL_SERVICE_API_KEY=compatibility-secret-during-workload-identity-migration
RUNTIME_SERVICE_API_KEY=compatibility-secret-during-oidc-migration
RUNTIME_INTERNAL_SERVICE_API_KEY=compatibility-secret-during-workload-identity-migration
RUNTIME_LLM_GATEWAY_API_KEY=compatibility-secret
RAG_CORS_ORIGINS=["https://agent.example.com"]
RAG_EMBEDDING_MODEL_REVISION=BAAI/bge-m3@approved-image-digest
RAG_LOCAL_EMBEDDING_BASE_URL=https://embedding-inference.internal.example.com

CONTROL_PLANE_ADMIN_API_KEY=compatibility-secret
CONTROL_PLANE_RUNTIME_API_KEY=compatibility-secret
GOVERNANCE_AUDITOR_API_KEY=compatibility-secret
GOVERNANCE_EVENT_INGESTION_KEY=compatibility-secret
GOVERNANCE_LLM_GATEWAY_API_KEY=compatibility-secret
GOVERNANCE_JUDGE_PRIMARY_MODEL_REVISION=provider-model-revision-or-image-digest
GOVERNANCE_JUDGE_SECONDARY_MODEL_REVISION=provider-model-revision-or-image-digest
GOVERNANCE_JUDGE_ARBITRATOR_MODEL_REVISION=provider-model-revision-or-image-digest
GOVERNANCE_JUDGE_MODEL_ROUTE_VERSION=governance-evaluation-v1
RAG_LLM_GATEWAY_API_KEY=compatibility-secret
GOVERNANCE_TRACE_SAMPLE_RATE=0.1
GOVERNANCE_KAFKA_MAX_POLL_RECORDS=500
GOVERNANCE_KAFKA_RETRY_BACKOFF_MAX_SECONDS=60
PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.33.1
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:v0.28.0
# Secret-managed production receiver config; the repository sample intentionally points to no real tenant.
ALERTMANAGER_CONFIG_FILE=/secure/alertmanager.yaml
RUNTIME_TEMPORAL_GLOBAL_NAMESPACE_ENABLED=true
RUNTIME_TEMPORAL_SECONDARY_TARGET=temporal-secondary.example.internal:7233
TOOL_GATEWAY_SERVICE_API_KEY=compatibility-secret
TOOL_GATEWAY_ADMIN_API_KEY=compatibility-secret
LLM_ADMIN_PASSWORD=secret-manager-reference
MODEL_LAB_SERVICE_API_KEY=compatibility-secret
AGENT_LAB_SERVICE_API_KEY=compatibility-secret
KNOWLEDGE_WIKI_SERVICE_API_KEY=compatibility-secret

OTEL_BACKEND_ENDPOINT=telemetry-backend.example.com:4317
OTEL_BACKEND_INSECURE=false
