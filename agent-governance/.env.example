GOVERNANCE_ENVIRONMENT=local
GOVERNANCE_DATABASE_PATH=./data/governance.db
GOVERNANCE_ENFORCE_AUDITOR_ROLE=false
# When set, event producers must send X-Governance-Event-Key.
GOVERNANCE_EVENT_INGESTION_KEY=
GOVERNANCE_AUDITOR_API_KEY=
GOVERNANCE_ONLINE_TRACE_SAMPLE_RATE=1.0
GOVERNANCE_CAPTURE_PROMPT_RESPONSE_CONTENT=false
GOVERNANCE_ONLINE_TRACE_RETENTION_DAYS=30
# 生产时必须为 true；Governance API 仅接受平台 CA 签发的客户端证书。
GOVERNANCE_MTLS_ENABLED=false
GOVERNANCE_MTLS_CA_FILE=
GOVERNANCE_MTLS_CERT_FILE=
GOVERNANCE_MTLS_KEY_FILE=
