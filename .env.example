# Copy this file to the repository-root `.env`; never commit `.env`.
# This is the upstream DeepSeek credential used by LLM Gateway. It is not the
# Runtime-to-Gateway service key, which is managed separately by deployment.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
# 设置为 true 后 Runtime 才会请求 Gateway；未配置 Key 的本地联调保持 false。
RUNTIME_LLM_ENABLED=true
RUNTIME_LLM_STARTUP_CHECK=true
