# Copy this file to the repository-root `.env`; never commit `.env`.
# Provider credentials are read only by LLM Gateway.  They are not Runtime-to-Gateway
# service credentials, and an empty value means that provider remains unavailable rather
# than silently falling back to a different vendor.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=
# Optional self-hosted OpenAI-compatible endpoints.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_API_KEY=vllm
VLLM_MODEL=local-chat
# 设置为 true 后 Runtime 才会请求 Gateway；未配置 Key 的本地联调保持 false。
RUNTIME_LLM_ENABLED=true
RUNTIME_LLM_STARTUP_CHECK=true

# Local OIDC demonstration account. The identity overlay is now enabled by the unified launcher.
# Override the password in the ignored `.env`; production must use an enterprise IdP and secret store.
LOCAL_PLATFORM_ADMIN_USERNAME=admin
LOCAL_PLATFORM_ADMIN_PASSWORD=replace-with-a-local-admin-password
