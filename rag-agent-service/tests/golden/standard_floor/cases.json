{
  "description": "3.2a 标准底线核查的 golden。直接给'已抽好的企业断言'(attribute+value),测比对规则的三态判定(PASS达标/FAIL低于底线/UNKNOWN无法判定)。抽取那半属LLM,规则这半必须确定可复现,故单独立此尺子。",
  "cases": [
    {
      "name": "洁净度达标-等于底线",
      "attribute": "洁净度等级",
      "value": "D级",
      "expected_verdict": "PASS"
    },
    {
      "name": "洁净度达标-严于底线",
      "attribute": "洁净度等级",
      "value": "A级",
      "expected_verdict": "PASS"
    },
    {
      "name": "洁净度别名命中-环境控制级别B级",
      "attribute": "环境控制级别",
      "value": "B级",
      "expected_verdict": "PASS"
    },
    {
      "name": "洁净度无法判定-无级别要求",
      "attribute": "洁净度等级",
      "value": "无级别要求",
      "expected_verdict": "UNKNOWN"
    },
    {
      "name": "微生物限度达标-50≤100",
      "attribute": "纯化水微生物限度",
      "value": "不超过50 CFU/mL",
      "expected_verdict": "PASS"
    },
    {
      "name": "微生物限度不达标-150>100",
      "attribute": "纯化水微生物限度",
      "value": "不超过150 CFU/mL",
      "expected_verdict": "FAIL"
    },
    {
      "name": "电导率达标-等于底线",
      "attribute": "纯化水电导率",
      "value": "5.1 μS/cm",
      "expected_verdict": "PASS"
    },
    {
      "name": "记录保存期限达标-越长越合规-2年≥1年",
      "attribute": "记录保存期限",
      "value": "产品有效期后2年",
      "expected_verdict": "PASS"
    },
    {
      "name": "无法判定-属性不在底线表",
      "attribute": "员工人数",
      "value": "20人",
      "expected_verdict": "UNKNOWN"
    },
    {
      "name": "无法判定-值无可比数值",
      "attribute": "纯化水微生物限度",
      "value": "符合规定",
      "expected_verdict": "UNKNOWN"
    }
  ]
}
