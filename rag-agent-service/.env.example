RAG_APP_NAME=rag-agent-service
RAG_API_PREFIX=/api/v1
RAG_DATA_DIR=data
RAG_PERSISTENCE=sqlite
RAG_REQUIRE_SERVICE_AUTH=false
RAG_SERVICE_API_KEY=

# RAG -> llm-gateway -> 厂家模型。这里填写网关逻辑模型名，不填写厂家模型密钥。
RAG_LLM_ENABLED=true
RAG_LLM_GATEWAY_BASE_URL=http://localhost:8080
RAG_LLM_GATEWAY_API_KEY=
RAG_LLM_GATEWAY_USER_ID=rag-agent-service
RAG_LLM_MODEL=deepseek-v4-flash
RAG_LLM_TIMEOUT=60
RAG_LLM_STARTUP_CHECK=true
RAG_LLM_BATCH_SIZE=8
RAG_GENERATION_MODEL=deepseek-v4-flash
RAG_GENERATION_TIMEOUT=120

RAG_BM25_WEIGHT=0.55
RAG_VECTOR_WEIGHT=0.45
RAG_TOP_K=8
RAG_RETRIEVAL_CANDIDATE_K=32

# disabled | memory | redis. Redis is the only cache backend accepted by the
# production startup policy. A cache hit additionally requires a frozen index
# manifest and authorization-scope digest, so legacy/inline reads are BYPASS.
RAG_SEMANTIC_CACHE_BACKEND=disabled
RAG_SEMANTIC_CACHE_TTL_SECONDS=60
RAG_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.985
RAG_SEMANTIC_CACHE_MAX_ENTRIES_PER_PARTITION=24
# Only needed with RAG_SEMANTIC_CACHE_BACKEND=redis; do not put production
# credentials in this example file.
RAG_REDIS_URL=

# none | cross_encoder | vendor. Local Cross-Encoder requires `.[rerank-local]`.
RAG_RERANK_PROVIDER=none
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_BASE_URL=
RAG_RERANK_API_KEY=
RAG_RERANK_TIMEOUT=15
RAG_RERANK_BATCH_SIZE=16

RAG_AGENT_ENABLED=true
RAG_AGENT_MODEL=deepseek-v4-flash
RAG_AGENT_MAX_STEPS=8
RAG_AGENT_TOOL_TIMEOUT=20
RAG_AGENT_DEADLINE_SECONDS=60
RAG_AGENT_ATTEMPT_BUDGET=6
RAG_AGENT_MAX_COST_USD=1.0
# Gateway and Runtime normalize every provider cost to USD.
RAG_AGENT_MAX_LLM_CALLS=8
RAG_AGENT_MAX_TOOL_CALLS=6
RAG_AGENT_MAX_RETRIEVAL_ROUNDS=4
RAG_AGENT_LLM_CALL_RESERVATION_USD=0.01
RAG_AGENT_TOOL_CALL_RESERVATION_USD=0.001
RAG_RUNTIME_FLOW_VERSION=1
RAG_RUNTIME_SNAPSHOT_REQUIRED=true
RAG_CONTROL_PLANE_BASE_URL=http://localhost:8082
RAG_CONTROL_PLANE_RUNTIME_KEY=replace-with-control-plane-runtime-key
RAG_GOVERNANCE_BASE_URL=http://localhost:8081
RAG_GOVERNANCE_EVENT_KEY=replace-with-governance-event-key
RAG_CONTEXT_SERVICE_BASE_URL=http://localhost:8002
RAG_RAG_QUERY_BASE_URL=http://localhost:8003
RAG_TOOL_GATEWAY_BASE_URL=http://localhost:8090
RAG_TOOL_GATEWAY_API_KEY=replace-with-the-tool-gateway-service-secret
RAG_TOOL_GATEWAY_STARTUP_CHECK=true
RAG_INTERNAL_SERVICE_API_KEY=
RAG_SERVICE_HTTP_TIMEOUT=30
RAG_CONTEXT_MAX_MESSAGES=12
RAG_CONTEXT_TOKEN_BUDGET=12000
# Initial share reserved for conversation memory; unused tokens are redistributed by score.
RAG_CONTEXT_MESSAGE_BUDGET_RATIO=0.4
RAG_INGESTION_POLL_INTERVAL=1

# OTLP/HTTP endpoint. Enable both services to obtain one distributed trace.
RAG_OTEL_ENABLED=false
RAG_OTEL_SERVICE_NAME=rag-agent-service
RAG_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
RAG_OTEL_ENVIRONMENT=local
