{
  "version": "2026-07-di-v1",
  "description": "数据可靠性(ALCOA+)核查项。对标数据完整性原则和药企飞检高风险项。fieldChecks:关键字段是否齐全;alcoaRisks:ALCOA+ 硬伤排查。",
  "fieldChecks": [
    {
      "id": "FIELD-DATE",
      "field": "日期/时间",
      "requirement": "记录应包含操作发生的日期,关键操作还应记录具体时间。",
      "keywords": ["日期", "时间", "date", "time", "年", "月", "日"],
      "severity": "高"
    },
    {
      "id": "FIELD-OPERATOR",
      "field": "责任人/操作人签名",
      "requirement": "记录应由执行操作的人员签名(或电子签名),明确责任归属。",
      "keywords": ["操作人", "责任人", "签名", "签字", "operator", "signature", "执行人"],
      "severity": "高"
    },
    {
      "id": "FIELD-REVIEWER",
      "field": "复核人/审核人签名",
      "requirement": "关键记录应有第二人复核并签名,体现双人复核和职责分离。",
      "keywords": ["复核", "审核", "复核人", "审核人", "reviewer", "checked by", "复查"],
      "severity": "高"
    },
    {
      "id": "FIELD-BATCH",
      "field": "生产批号",
      "requirement": "生产相关记录应标明产品批号,以支持批次追溯。",
      "keywords": ["批号", "批次", "batch", "lot", "生产批"],
      "severity": "中"
    },
    {
      "id": "FIELD-EQUIPMENT",
      "field": "设备编号",
      "requirement": "涉及设备的操作应记录设备编号/位号,以支持设备追溯。",
      "keywords": ["设备编号", "设备号", "位号", "equipment", "仪器编号", "设备ID"],
      "severity": "中"
    },
    {
      "id": "FIELD-AUDITTRAIL",
      "field": "审计追踪",
      "requirement": "电子记录必须具备审计追踪,记录数据的创建、修改、删除及其操作人、时间、原因,且不可关闭、不可篡改。",
      "keywords": ["审计追踪", "audit trail", "操作日志", "修改记录", "变更历史", "trail"],
      "severity": "高"
    }
  ],
  "alcoaRisks": [
    {
      "id": "RISK-BACKFILL",
      "principle": "Contemporaneous(同步)",
      "risk": "事后补记",
      "requirement": "记录应在操作发生时同步填写,禁止事后凭记忆补记。文件中应明确要求实时记录。",
      "redFlags": ["事后填写", "统一补录", "事后补记", "凭记忆", "回忆填写", "集中填写"],
      "expect": ["及时记录", "实时记录", "同步记录", "操作时记录", "当场记录"],
      "severity": "高"
    },
    {
      "id": "RISK-NOTRACE",
      "principle": "Attributable(可归属)/审计追踪",
      "risk": "修改无痕/无审计追踪",
      "requirement": "任何数据修改都应留痕(原值可见、修改人、时间、原因),禁止无痕覆盖或使用涂改液。",
      "redFlags": ["涂改", "覆盖原值", "直接修改", "无需记录原因", "橡皮擦", "修正液"],
      "expect": ["杠改", "划改", "保留原值", "注明修改原因", "修改留痕", "单线划掉"],
      "severity": "高"
    },
    {
      "id": "RISK-ORIGINAL",
      "principle": "Original(原始)",
      "risk": "原始数据缺失/不可溯源",
      "requirement": "应保留原始数据(原始记录、原始图谱、电子原始数据),誊抄件不能替代原始记录。",
      "redFlags": ["誊抄", "转抄", "重新填写", "原始记录销毁", "只保留誊清"],
      "expect": ["原始记录", "原始数据", "原始图谱", "保留原件", "raw data"],
      "severity": "高"
    },
    {
      "id": "RISK-ACCESS",
      "principle": "Attributable(可归属)",
      "risk": "共享账号/权限不清",
      "requirement": "电子系统应为每人分配独立账号,禁止共享账号,确保操作可归属到个人。",
      "redFlags": ["共享账号", "公用账号", "共用密码", "统一账号"],
      "expect": ["独立账号", "个人账号", "唯一用户", "权限分级", "专人专账"],
      "severity": "中"
    }
  ]
}
