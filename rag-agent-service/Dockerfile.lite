FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /service
COPY rag-agent-service/requirements-lite.txt ./requirements-lite.txt
RUN pip install --no-cache-dir -r requirements-lite.txt

COPY rag-agent-service/app ./app
COPY rag-agent-service/apps ./apps

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /service/data \
    && chown -R appuser:appuser /service
USER appuser

CMD ["uvicorn", "apps.compliance_lite.main:app", "--host", "0.0.0.0", "--port", "8000"]
