{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-agent-platform.local/contracts/execution-context.v1.json",
  "title": "ExecutionContextV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "traceId",
    "runId",
    "sessionId",
    "tenantId",
    "userId",
    "agentId",
    "agentVersion",
    "snapshotId",
    "deadlineAt",
    "attemptBudgetRemaining"
  ],
  "properties": {
    "requestId": {"type": "string", "minLength": 1, "maxLength": 160},
    "traceId": {"type": "string", "minLength": 1, "maxLength": 160},
    "runId": {"type": "string", "minLength": 1, "maxLength": 160},
    "sessionId": {"type": "string", "minLength": 1, "maxLength": 160},
    "parentSessionId": {"type": "string", "maxLength": 160},
    "tenantId": {"type": "string", "minLength": 1, "maxLength": 160},
    "userId": {"type": "string", "minLength": 1, "maxLength": 160},
    "agentId": {"type": "string", "minLength": 1, "maxLength": 160},
    "agentVersion": {"type": "string", "minLength": 1, "maxLength": 160},
    "snapshotId": {"type": "string", "minLength": 1, "maxLength": 160},
    "releaseId": {"type": "string", "maxLength": 160},
    "releaseStage": {"enum": ["shadow", "canary", "production"]},
    "releaseProjectionRevision": {"type": "integer", "minimum": 1},
    "trafficPolicyVersion": {"type": "string", "maxLength": 160},
    "sideEffectPolicyVersion": {"type": "string", "maxLength": 160},
    "deadlineAt": {"type": "string", "format": "date-time"},
    "attemptBudgetRemaining": {"type": "integer", "minimum": 0, "maximum": 1000},
    "purpose": {"type": "string", "maxLength": 160}
  }
}
