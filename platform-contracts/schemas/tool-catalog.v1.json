{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/tool-catalog.v1.json",
  "type": "object",
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "items": {"$ref": "#/$defs/tool"}
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "version", "input_schema", "transport", "required_permissions"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,149}$"},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "input_schema": {"type": "object"},
        "required_permissions": {"type": "array", "items": {"type": "string"}},
        "risk": {"enum": ["read_only", "write_low_risk", "write_high_risk", "human_approval_required"]},
        "approval_required": {"type": "boolean"},
        "transport": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["http", "mcp_streamable_http"]}}}
      },
      "additionalProperties": true
    }
  }
}
