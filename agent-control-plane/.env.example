CONTROL_PLANE_ENVIRONMENT=local
CONTROL_PLANE_DATABASE_PATH=./data/control-plane.db
CONTROL_PLANE_ENFORCE_ADMIN_ROLE=false
# 设置后，Runtime API 必须携带 X-Runtime-Key。
CONTROL_PLANE_RUNTIME_API_KEY=
CONTROL_PLANE_ADMIN_API_KEY=
CONTROL_PLANE_GOVERNANCE_AUDITOR_API_KEY=
CONTROL_PLANE_AGENT_RELEASE_QUALITY_GATE_REQUIRED=false
# Pydantic JSON 数组格式，例如 ["http://localhost:3000"]。
CONTROL_PLANE_CORS_ORIGINS=[]
