CONTROL_PLANE_ENVIRONMENT=local
CONTROL_PLANE_DATABASE_PATH=./data/control-plane.db
CONTROL_PLANE_ENFORCE_ADMIN_ROLE=false
# 设置后，Runtime API 必须携带 X-Runtime-Key。
CONTROL_PLANE_RUNTIME_API_KEY=
CONTROL_PLANE_ADMIN_API_KEY=
CONTROL_PLANE_GOVERNANCE_AUDITOR_API_KEY=
CONTROL_PLANE_AGENT_RELEASE_QUALITY_GATE_REQUIRED=false
CONTROL_PLANE_MODEL_LAB_BASE_URL=http://localhost:8091
CONTROL_PLANE_MODEL_LAB_REQUIRED=false
CONTROL_PLANE_AGENT_LAB_BASE_URL=http://localhost:8092
CONTROL_PLANE_AGENT_LAB_SERVICE_API_KEY=local-agent-lab-key
CONTROL_PLANE_AGENT_LAB_REQUIRED=false
CONTROL_PLANE_RUNTIME_EXECUTOR_CATALOG_PATH=./config/runtime-executors.json
CONTROL_PLANE_RUNTIME_EXECUTOR_CATALOG_REQUIRED=false
CONTROL_PLANE_RUNTIME_EXECUTOR_CATALOG_SERVICE_API_KEY=
# Pydantic JSON 数组格式，例如 ["http://localhost:3000"]。
CONTROL_PLANE_CORS_ORIGINS=[]
# 生产时必须为 true，并由统一 ASGI 启动器使用同一证书要求客户端证书。
CONTROL_PLANE_MTLS_ENABLED=false
CONTROL_PLANE_MTLS_CA_FILE=
CONTROL_PLANE_MTLS_CERT_FILE=
CONTROL_PLANE_MTLS_KEY_FILE=
