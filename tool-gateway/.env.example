TOOL_GATEWAY_APP_NAME=tool-gateway
TOOL_GATEWAY_API_PREFIX=/api/v1
TOOL_GATEWAY_DATABASE_PATH=data/tool-gateway.db
TOOL_GATEWAY_TOOLS_CONFIG_PATH=config/tools.json

# Agent Runtime -> Tool Gateway service credential.
TOOL_GATEWAY_REQUIRE_SERVICE_AUTH=true
TOOL_GATEWAY_SERVICE_API_KEY=replace-with-a-long-random-secret

# Separate credential for approval decisions. Never expose it to a model or browser client.
TOOL_GATEWAY_ADMIN_API_KEY=replace-with-a-different-long-random-secret

# The bundled Docker catalog uses internal service DNS names.
TOOL_GATEWAY_ALLOW_PRIVATE_NETWORKS=true
TOOL_GATEWAY_APPROVAL_TTL_SECONDS=900
TOOL_GATEWAY_IDEMPOTENCY_TTL_SECONDS=86400
TOOL_GATEWAY_MAX_REQUEST_BYTES=1000000
TOOL_GATEWAY_MAX_RESPONSE_BYTES=1000000

# Optional durable event sink; undelivered events remain in event_outbox for retry.
TOOL_GATEWAY_GOVERNANCE_BASE_URL=http://agent-governance:8081
TOOL_GATEWAY_GOVERNANCE_EVENT_KEY=replace-with-governance-event-key

# Optional credential referenced by a tool transport's auth_env.
TOOL_GATEWAY_RAG_AGENT_API_KEY=
