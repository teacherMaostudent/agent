{
  "tools": [
    {
      "name": "get_document",
      "version": "1.0.0",
      "description": "Read one parsed enterprise document by document id.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          }
        },
        "required": ["document_id"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_permissions": ["document:read"],
      "risk": "read_only",
      "approval_required": false,
      "enabled_tenants": ["*"],
      "idempotent": true,
      "timeout_seconds": 20,
      "retry_attempts": 2,
      "rate_limit_per_minute": 120,
      "breaker_failure_threshold": 5,
      "breaker_reset_seconds": 30,
      "transport": {
        "kind": "http",
        "url": "http://ingestion-api:8004/api/v1/ingestion/documents/{document_id}",
        "method": "GET",
        "argument_location": "query",
        "static_headers": {},
        "allowed_hosts": ["ingestion-api"]
      }
    },
    {
      "name": "create_ingestion_job",
      "version": "1.0.0",
      "description": "Create a PARSE, OCR, or REINDEX knowledge-ingestion job.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "job_type": {
            "type": "string",
            "enum": ["PARSE", "OCR", "REINDEX"]
          },
          "document_id": {
            "type": ["string", "null"],
            "minLength": 3,
            "maxLength": 160
          },
          "payload": {
            "type": "object"
          }
        },
        "required": ["job_type"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["job_id", "status"]
      },
      "required_permissions": ["ingestion:write"],
      "risk": "write_low_risk",
      "approval_required": false,
      "enabled_tenants": ["*"],
      "idempotent": false,
      "timeout_seconds": 20,
      "retry_attempts": 1,
      "rate_limit_per_minute": 30,
      "breaker_failure_threshold": 5,
      "breaker_reset_seconds": 30,
      "transport": {
        "kind": "http",
        "url": "http://ingestion-api:8004/api/v1/ingestion/jobs",
        "method": "POST",
        "argument_location": "json",
        "static_headers": {},
        "allowed_hosts": ["ingestion-api"]
      }
    }
  ]
}
