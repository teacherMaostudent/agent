AGENT_LAB_ENVIRONMENT=local
AGENT_LAB_DATABASE_BACKEND=sqlite
AGENT_LAB_DATABASE_PATH=./data/agent-lab.db
AGENT_LAB_DATABASE_URL=
AGENT_LAB_DATABASE_SCHEMA=agent_lab
AGENT_LAB_CONTROL_PLANE_BASE_URL=http://localhost:8082
AGENT_LAB_RUNTIME_BASE_URL=http://localhost:8001
AGENT_LAB_GOVERNANCE_BASE_URL=http://localhost:8081
AGENT_LAB_CONTROL_PLANE_RUNTIME_KEY=local-control-plane-key
AGENT_LAB_GOVERNANCE_AUDITOR_KEY=local-governance-auditor-key
AGENT_LAB_SERVICE_API_KEY=local-agent-lab-key
AGENT_LAB_MAX_CASES=50
AGENT_LAB_REQUEST_TIMEOUT_SECONDS=120
AGENT_LAB_TEMPORAL_ENABLED=false
AGENT_LAB_TEMPORAL_TARGET=localhost:7233
AGENT_LAB_TEMPORAL_NAMESPACE=default
AGENT_LAB_TEMPORAL_TASK_QUEUE=agent-lab-experiments
AGENT_LAB_JOB_LEASE_SECONDS=900
AGENT_LAB_JOB_MAX_ATTEMPTS=5
AGENT_LAB_RETRY_INITIAL_SECONDS=5
AGENT_LAB_RETRY_MAX_SECONDS=300
AGENT_LAB_OIDC_ENABLED=false
AGENT_LAB_OIDC_ISSUER=
AGENT_LAB_OIDC_JWKS_URL=
AGENT_LAB_WORKLOAD_TOKEN_URL=
AGENT_LAB_WORKLOAD_CLIENT_ID=agent-lab
AGENT_LAB_WORKLOAD_CLIENT_SECRET=
AGENT_LAB_MTLS_ENABLED=false
AGENT_LAB_MTLS_CA_FILE=
AGENT_LAB_MTLS_CERT_FILE=
AGENT_LAB_MTLS_KEY_FILE=
AGENT_LAB_SANDBOX_PROVIDER=docker
# Pydantic Settings reads structured environment values as JSON. Only exact image matches run.
AGENT_LAB_SANDBOX_IMAGE_ALLOWLIST=["python:3.12-slim"]
